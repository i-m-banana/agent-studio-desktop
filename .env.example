MYSQL_DATABASE=agent_studio
MYSQL_USER=agent_studio
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=23306
MYSQL_HOST=localhost
POSTGRES_DB=agent_studio_vector
POSTGRES_USER=agent_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432
POSTGRES_HOST=localhost

# RAG embedding（默认使用本机 Ollama；local-hash 可离线回退）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_INDEX_VERSION=qwen3-0.6b-v1
OLLAMA_BASE_URL=http://localhost:11434
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.05
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS_PER_ROUND=4
AGENT_APPROVAL_TIMEOUT=90s
AGENT_RUN_TIMEOUT=120s
