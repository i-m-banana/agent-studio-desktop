MYSQL_DATABASE=agent_studio
MYSQL_USER=agent_studio
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=23306
MYSQL_HOST=localhost
POSTGRES_DB=agent_studio_vector
POSTGRES_USER=agent_studio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432
POSTGRES_HOST=localhost

# RAG embedding（默认使用本机 Ollama；local-hash 可离线回退）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_INDEX_VERSION=qwen3-0.6b-v1
OLLAMA_BASE_URL=http://localhost:11434
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.05
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS_PER_ROUND=4
# Local coding tasks need more rounds to read, edit and verify; approval rules remain unchanged.
AGENT_CODING_MAX_TOOL_ROUNDS=96
AGENT_CODING_MAX_TOOL_CALLS_PER_ROUND=16
AGENT_CODING_RUN_TIMEOUT=1800s
AGENT_APPROVAL_TIMEOUT=90s
AGENT_RUN_TIMEOUT=120s

# Coding 授权工作区；只对信任的本地项目开启构建/测试
AGENT_STUDIO_CODING_WORKSPACE=D:/projects/example-repository
# Explicit project roots, separated by semicolons. Never use a drive root or shared parent.
AGENT_STUDIO_PROJECT_ROOTS=D:/projects/example-repository
AGENT_STUDIO_PROTECTED_ROOTS=
AGENT_STUDIO_SANDBOX_IMAGE=
AGENT_STUDIO_DOCKER_EXECUTABLE=
# 可选：PATH 无法稳定解析时填写宿主机程序的绝对路径
# AGENT_STUDIO_MAVEN_COMMAND=D:/tools/apache-maven/bin/mvn.cmd
# AGENT_STUDIO_NPM_COMMAND=C:/Program Files/nodejs/npm.cmd

# SSH/SFTP 远程只读工作区；必须填写 ssh-keyscan/ssh-keygen 确认的 SHA256 主机指纹
# 密码通过“安全凭据”页面保存为 AGENT_STUDIO_SSH_PASSWORD，不要写入此文件
# AGENT_STUDIO_SSH_HOST=example.com
# AGENT_STUDIO_SSH_PORT=22
# AGENT_STUDIO_SSH_USERNAME=agentstudio
# AGENT_STUDIO_SSH_REMOTE_ROOT=/srv/example-app
# AGENT_STUDIO_SSH_HOST_KEY_SHA256=SHA256:replace-with-verified-fingerprint
# AGENT_STUDIO_SSH_PASSWORD_SECRET=AGENT_STUDIO_SSH_PASSWORD
AGENT_STUDIO_MYSQL_IMAGE=
